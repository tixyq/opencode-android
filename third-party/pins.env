# Pinned third-party artifacts (exact bytes, verified by hash at fetch time).
# Bump a pin = update URL + hash + run tools/fetch-*.sh.

# --- Termux base (official app APK; bootstrap zip lives inside as a lib) ---
# com.termux 0.119.0-beta.3 (versionCode 1022). The inner
# lib/arm64-v8a/libtermux-bootstrap.so IS the bootstrap zip, byte-identical.
TERMUX_APK_URL="https://f-droid.org/repo/com.termux_1022.apk"
TERMUX_APK_SHA256="fdd476982cd74f2f00aac12d3683b1fa260a0b2d146411b94e09d773be3a7b56"
TERMUX_BOOTSTRAP_INNER_SHA256="6ebaabb7d42234077f0cabdcc4581d0b680077ef858e926aba915c24b58178d8"
TERMUX_APK_VERSION_CODE="1022"

# --- Termux system packages (primary mirror; hashes verified on fetch) ---
TERMUX_POOL="https://packages.termux.dev/apt/termux-main/pool/main"
TERMUX_DEB_PROOT="p/proot/proot_5.1.107.96_aarch64.deb"
TERMUX_DEB_PROOT_SHA256="8199dca06dccb693ec09fb1759e3e1ad08b4863f0c11c612f89c20bd9ecdc1a0"
TERMUX_DEB_TALLOC="libt/libtalloc/libtalloc_2.5.0_aarch64.deb"
TERMUX_DEB_TALLOC_SHA256="556591f43bb773ad8777e1a29522640866a55f95dab71914418b94a8c58ad5a7"
TERMUX_DEB_SHMEM="liba/libandroid-shmem/libandroid-shmem_0.7_aarch64.deb"
TERMUX_DEB_SHMEM_SHA256="0da3a24d558b93c92bcf8d611e0826a99ff96e396b148e6cdf33b47c47c57ff6"

# --- OpenCode server (Hope2333 Termux port; updater tracks latest at runtime) ---
OPENCODE_TAG="Push261013"
OPENCODE_ASSET="opencode_2.0.27_aarch64.deb"
OPENCODE_DEB_SHA256="4bf8c82807d9fd816612dcda3f9ea5a46871fe2de03986bb8933f39517e942d1"
OPENCODE_BIN_SHA256="179cd70dd59becf792b1054eb5a0eb42a5018ef131a6176b013d69803becbaea"
OPENCODE_RELEASE_BASE="https://github.com/Hope2333/opencode-termux/releases/download"
OPENCODE_TAGS_ATOM="https://github.com/Hope2333/opencode-termux/tags.atom"

# --- PTY bridge (Rust cdylib; submodule + patch + local stub crate) ---
BUN_PTY_REPO="https://github.com/sursaone/bun-pty.git"
BUN_PTY_COMMIT="41dd5b8"
# portable-pty version is pinned by rust/bun-pty.patch + rust/stub-serial + Cargo.lock

# --- Web UI mirror (live site snapshot; hashes in webui/MANIFEST.sha256) ---
WEBUI_BASE_URL="https://beta.opencode.ai"

# --- Android SDK (via cmdline-tools sdkmanager; Termux host alternative noted) ---
ANDROID_PLATFORM="platforms;android-28"
