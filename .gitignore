# OpenCode for Android — self-contained APK
# (Termux userland + proot + OpenCode server + bundled web UI)

# Build outputs
/OpenCode-*.apk
/OpenCode-*.apk.idsig
/out/
/app/assets/
/download/
/build/

# Generated/pinned blobs (fetched by tools/fetch-*.sh, never committed)
*.apk
*.idsig
*.zip
*.deb
*.so
# ...except the vendored libopentui snapshot (see third-party/PROVENANCE.md)
!third-party/libopentui.so
!third-party/libopentui.so.sha256
pinned/
*.log
*.out
tmp/

# Secrets: debug keystore is generated by tools/build.sh on first run
keys/
*.jks
*.keystore
storepass.txt
*.p12

# Rust build artifacts
rust/bun-pty/**/target/
target/

# Web UI mirror (fetched + hash-verified, then overlaid)
/webui/base/

# OS / editor noise
.DS_Store
*~
*.swp
.idea/
.vscode/
